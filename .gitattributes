# Everything is built and run inside Linux containers, so keep LF line endings
# in the working tree even on Windows (core.autocrlf=true would otherwise break
# shell scripts with "bash\r: No such file or directory").
* text=auto eol=lf

# RAPID modules for RobotStudio / the ABB controller keep their original CRLF.
*.mod -text

# Upstream ABB sources that are stored with CRLF in the index.
ABB/**/.clang-format -text
